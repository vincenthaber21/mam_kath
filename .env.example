# Copy this file to .env and adjust.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# For a deployed site, e.g. https://eic.onrender.com
CSRF_TRUSTED_ORIGINS=
# Leave empty to use the local SQLite file (db.sqlite3). Example: postgres://user:pass@host:5432/eic
DATABASE_URL=
TIME_ZONE=Asia/Manila
LOW_CONFIDENCE_THRESHOLD=0.60
# True = simulated predictions while no trained model file is active (clearly labelled "Demo").
# Set to False before collecting real thesis results.
EIC_DEMO_MODE=True
MAX_TEST_SET_MB=500
