# Copy this file to .env and adjust.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,bb6cjv85-8000.asse.devtunnels.ms,.asse.devtunnels.ms,.trycloudflare.com
# For a deployed site / public tunnel, e.g. https://eic.onrender.com or https://….trycloudflare.com
CSRF_TRUSTED_ORIGINS=https://bb6cjv85-8000.asse.devtunnels.ms
# Mobile API CORS (Expo web). Native apps ignore Origin. True while DEBUG by default.
CORS_ALLOW_ALL=True
CORS_ALLOWED_ORIGINS=
# Leave empty to use the local SQLite file (db.sqlite3). Example: postgres://user:pass@host:5432/eic
DATABASE_URL=
TIME_ZONE=Asia/Manila
LOW_CONFIDENCE_THRESHOLD=0.70
# True = simulated predictions while no trained model file is active (clearly labelled "Demo").
# Set to False before collecting real thesis results.
EIC_DEMO_MODE=True
MAX_TEST_SET_MB=500
# Google Maps JavaScript API key for /incidents/map/ (restrict by HTTP referrer in Google Cloud Console).
GOOGLE_MAPS_API_KEY=
